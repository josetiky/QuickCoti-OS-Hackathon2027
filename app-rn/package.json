{
  "name": "quickcoti-os",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "android": "expo run:android --device",
    "prebuild": "expo prebuild --clean",
    "test:rules": "npx tsx src/compliance.selftest.ts",
    "test:tema": "npx tsx src/tema.selftest.ts",
    "test:estadisticas": "npx tsx src/estadisticas.selftest.ts",
    "test:venta": "npx tsx src/venta.selftest.ts",
    "test:periodo": "npx tsx src/periodo.selftest.ts",
    "test:impuestos": "npx tsx src/impuestos.selftest.ts",
    "test:cotizacion": "npx tsx src/cotizacion.selftest.ts",
    "test:factura": "npx tsx src/factura.selftest.ts",
    "test:documentos": "npx tsx src/documentos.selftest.ts",
    "test:limpiar": "npx tsx src/ai/limpiar.selftest.ts",
    "test:titular": "npx tsx src/titular/valida.selftest.ts && npx tsx src/titular/almacen.selftest.ts",
    "postinstall": "node scripts/patch-onnxruntime.js"
  },
  "dependencies": {
    "@qvac/asr-ggml-android-arm64": "0.12.1",
    "@qvac/asr-ggml-ios": "0.12.1",
