    "@qvac/audiogen-ggml-ios": "0.10.1",
    "@qvac/diffusion-cpp-android-arm64": "0.35.1",
    "@qvac/diffusion-cpp-ios": "0.35.1",
    "@qvac/fabric-android-arm64": "0.29.2",
    "@qvac/fabric-ios": "0.29.2",
    "@qvac/sdk": "latest",
    "@qvac/tts-ggml-android-arm64": "0.15.1",
    "@qvac/tts-ggml-ios": "0.15.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "buffer": "^6.0.3",
    "expo": "^58.0.0",
    "expo-build-properties": "*",
    "expo-crypto": "*",
    "expo-device": "*",
    "expo-file-system": "*",
