    "expo-speech-recognition": "^58.0.1",
    "expo-status-bar": "*",
    "jpeg-js": "^0.4.4",
    "onnxruntime-react-native": "^1.20.0",
    "react": "19.3.0",
    "react-native": "*",
    "react-native-bare-kit": "^0.17.1",
    "react-native-qrcode-svg": "^6.3.0",
    "react-native-safe-area-context": "*",
